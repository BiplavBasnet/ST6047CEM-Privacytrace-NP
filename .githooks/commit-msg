#!/bin/sh
# Reject commits that contain third-party attribution trailers.
MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0
if grep -qiE '^[[:space:]]*(Co-authored-by:|Made-with:)' "$MSG_FILE"; then
  echo "ERROR: third-party attribution trailers are not allowed in commit messages." >&2
  exit 1
fi
exit 0
