# Copy to .env for local development (optional; can also export variables directly)

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

DATABASE_URL=postgresql://privacytrace:privacytrace_dev@localhost:5432/privacytrace_np
MAX_UPLOAD_BYTES=5242880

# AI Remediation Assistant (OpenCode Zen openai-compatible chat completions).
# Never commit real provider keys. Put the primary key in AI_API_KEY and comma-separated backups in AI_BACKUP_API_KEYS.
AI_ASSISTANT_ENABLED=true
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://opencode.ai/zen/v1
AI_MODEL=deepseek-v4-flash-free
AI_MODEL_CANDIDATES=deepseek-v4-flash-free,mimo-v2.5-free,nemotron-3-ultra-free
AI_API_KEY=
AI_BACKUP_API_KEYS=
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=8000

# Automatic rotation stays off for OpenCode Zen. Inference + backup failover remain
# supported. External Zen API-key lifecycle is provider-managed until an official
# machine credential-management API is available.
# After replacing keys at opencode.ai/auth, run:
#   python scripts/rotate_ai_credentials.py --preflight
#   python scripts/rotate_ai_credentials.py --validate
AI_CREDENTIAL_ROTATION_ENABLED=false
AI_CREDENTIAL_ROTATION_PROVIDER=opencode_zen
AI_CREDENTIAL_MANAGEMENT_SECRET=

# Privacy harm and breach-response module. Runtime customer delivery and credential providers remain disabled.
BREACH_ALERTS_ENABLED=true
CUSTOMER_NOTIFICATION_SEND_ENABLED=false
CREDENTIAL_AUTO_CONTAINMENT_ENABLED=false
BREACH_SEVERITY_MEDIUM_THRESHOLD=2.0
BREACH_SEVERITY_HIGH_THRESHOLD=3.0
BREACH_SEVERITY_VERY_HIGH_THRESHOLD=4.0
PRIVACY_HARM_MEDIUM_THRESHOLD=4
PRIVACY_HARM_HIGH_THRESHOLD=8
PRIVACY_HARM_CRITICAL_THRESHOLD=12
BREACH_CREDENTIAL_CATEGORIES=authorization_header,jwt_token,bearer_token,api_key,password,password_hash,credential_username,access_token,session_token,private_key
BREACH_INTERNAL_RECIPIENTS=
BREACH_WEBHOOK_DESTINATIONS=
NOTIFICATION_RETRY_COUNT=3
NOTIFICATION_RETRY_DELAY_SECONDS=300
BREACH_ALERT_DEDUPLICATION_WINDOW_SECONDS=3600
# Replace this local-only placeholder outside development. Never commit the real key.
SUBJECT_REFERENCE_HMAC_KEY=privacytrace-dev-subject-reference-key-change-me
BREACH_WEBHOOK_SIGNING_KEY=
# Integrated governance, integrity, prevention and Nepal taxonomy modules.
INTEGRITY_LEDGER_ENABLED=true
COUNTERFACTUAL_ANALYSIS_ENABLED=true
COUNTERFACTUAL_MAX_EVIDENCE_ITEMS=25
ALERT_ESCALATION_ENABLED=true
ALERT_DEFAULT_ACKNOWLEDGEMENT_MINUTES=30
ALERT_DEFAULT_CONTAINMENT_MINUTES=120
PREVENTIVE_CONTROL_GENERATION_ENABLED=true
PREVENTIVE_CONTROL_AI_GENERATION_ENABLED=false
OPA_VALIDATION_ENABLED=false
SEMGREP_VALIDATION_ENABLED=false
NEPAL_FINANCIAL_TAXONOMY_ENABLED=true
NEPAL_FINANCIAL_TAXONOMY_PATH=app/rules/nepal_financial_data_taxonomy.yaml
NEPAL_FINANCIAL_TAXONOMY_VERSION=np-dfs-1.0.0
COMBINED_EXPOSURE_RULES_ENABLED=true
COMBINED_EXPOSURE_RULES_PATH=app/rules/nepal_exposure_combination_rules.yaml
COMBINED_EXPOSURE_RULESET_VERSION=np-exposure-1.0.0
# Replace outside development. Never commit the real HMAC key.
DETECTION_HMAC_KEY=privacytrace-dev-detection-hmac-key-change-me
RESTRICTED_AML_HANDLING_ENABLED=true
DETECTOR_PREVIEW_ENABLED=false
CONTEXTUAL_SECRET_ENTROPY_ENABLED=true
DOCUMENT_METADATA_CLASSIFICATION_ENABLED=true

# Public self-registration (thesis demo). Set SELF_REGISTRATION_ENABLED=false and
# INVITE_ONLY_REGISTRATION=true for company deployments. Uninvited signup never
# grants organisation membership. Demo credentials are not company onboarding.
SELF_REGISTRATION_ENABLED=true
INVITE_ONLY_REGISTRATION=false
DEFAULT_REGISTRATION_ROLE=viewer
EMAIL_VERIFICATION_REQUIRED=false
# Company verification: manual (official OCR/IRD reference) or demo (simulated).
# demo only allowed when APP_ENV is dev/development/test/demo.
COMPANY_VERIFICATION_MODE=demo
PAN_VERIFICATION_REQUIRED=false

# One-time deployment bootstrap secret required for /setup and Platform Operator CLI.
# Never commit the real production value.
PRIVACYTRACE_BOOTSTRAP_TOKEN=dev-bootstrap-change-me

# SMTP for admin-email verify, invites, and password reset. When disabled in demo/test,
# one-time tokens may be returned in API responses for operator paste.
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@privacytrace.local
SMTP_TLS=true
FRONTEND_PUBLIC_URL=http://127.0.0.1:5173

# DNS-over-HTTPS resolver for domain TXT challenges (stdlib urllib only).
DNS_DOH_URL=https://cloudflare-dns.com/dns-query
DNS_LOOKUP_TIMEOUT_SECONDS=8
DNS_LOOKUP_MAX_RETRIES=2

