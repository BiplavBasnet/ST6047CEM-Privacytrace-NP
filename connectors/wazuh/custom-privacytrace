#!/usr/bin/env python3
"""Wazuh custom integrator: custom-privacytrace.

Install as /var/ossec/integrations/custom-privacytrace (root:wazuh, chmod 750).
Wazuh argv: [1]=alert file, [2]=api_key, [3]=hook_url.

Never forwards full_log, raw message, or nested data.*.
"""

from __future__ import annotations

import json
import sys
import uuid
from datetime import UTC, datetime
from pathlib import Path
from typing import Any
from urllib.request import Request, urlopen

EVENT_TYPE = "np.privacytrace.wazuh.alert.v1"


def _alert_time(value: Any) -> str:
    if not isinstance(value, str) or not value.strip():
        return datetime.now(UTC).isoformat()
    stamp = value.strip()
    if len(stamp) >= 5 and stamp[-5] in "+-" and stamp[-3] != ":":
        return f"{stamp[:-2]}:{stamp[-2:]}"
    return stamp


def map_alert(alert: dict[str, Any]) -> dict[str, Any]:
    """Allowlisted Wazuh JSON → connector envelope. Drops full_log and data.*."""
    rule = alert.get("rule") if isinstance(alert.get("rule"), dict) else {}
    agent = alert.get("agent") if isinstance(alert.get("agent"), dict) else {}
    manager = alert.get("manager") if isinstance(alert.get("manager"), dict) else {}
    groups = rule.get("groups") if isinstance(rule.get("groups"), list) else []
    rule_group = str(groups[0]) if groups else None
    rule_id = str(rule["id"]) if rule.get("id") is not None else None
    level = rule.get("level")
    rule_level = int(level) if isinstance(level, int) else None
    component = agent.get("name") or manager.get("name")
    event_id = str(alert.get("id") or uuid.uuid4().hex)
    data = {
        k: v
        for k, v in {
            "component": component if isinstance(component, str) else None,
            "rule_id": rule_id,
            "rule_group": rule_group[:128] if isinstance(rule_group, str) else None,
            "rule_level": rule_level,
            "severity": "high" if (rule_level or 0) >= 10 else "medium" if (rule_level or 0) >= 7 else "info",
            "message_summary": f"Wazuh rule {rule_id or 'unknown'} level {rule_level if rule_level is not None else 'n/a'}",
        }.items()
        if v is not None
    }
    envelope: dict[str, Any] = {
        "specversion": "1.0",
        "id": event_id[:128],
        "source": "/wazuh/custom-privacytrace",
        "type": EVENT_TYPE,
        "datacontenttype": "application/json",
        "data": data,
    }
    envelope["time"] = _alert_time(alert.get("timestamp"))
    return envelope


def _post(hook_url: str, api_key: str, envelope: dict[str, Any]) -> int:
    raw = json.dumps(envelope).encode("utf-8")
    request = Request(
        hook_url,
        data=raw,
        method="POST",
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
            "Accept": "application/json",
        },
    )
    with urlopen(request, timeout=10) as response:
        return int(response.status)


def main(argv: list[str] | None = None) -> int:
    args = argv if argv is not None else sys.argv[1:]
    if len(args) < 3:
        print("usage: custom-privacytrace <alert_file> <api_key> <hook_url>", file=sys.stderr)
        return 2
    alert_path, api_key, hook_url = args[0], args[1], args[2]
    try:
        alert = json.loads(Path(alert_path).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return 1
    if not isinstance(alert, dict):
        return 1
    envelope = map_alert(alert)
    try:
        _post(hook_url, api_key, envelope)
    except Exception:
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
