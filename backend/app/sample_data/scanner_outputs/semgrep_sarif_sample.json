{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "semgrep",
          "version": "1.0.0-demo"
        }
      },
      "results": [
        {
          "ruleId": "python.lang.security.audit.logging.logger-credential-leak",
